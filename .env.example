# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env — it's already in .gitignore.

# --- Phase 1: OpenAI drives the agent loop ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Phase 3: RAG embeddings (same OpenAI key works) ---
EMBED_MODEL=text-embedding-3-small

# --- Phase 4: Jira (sooperset/mcp-atlassian, classic API token, read-only) ---
JIRA_URL=https://YOURNAME.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=your-classic-jira-api-token

# --- Phase 5: Gmail (path to the OAuth client JSON you downloaded) ---
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json
