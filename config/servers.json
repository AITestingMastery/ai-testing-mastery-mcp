{
  "qa": {
    "command": "python",
    "args": ["servers/qa_server.py"]
  },
  "rag": {
    "command": "python",
    "args": ["servers/rag_server.py"]
  },
  "jira": {
    "command": "uvx",
    "args": ["mcp-atlassian"],
    "env": {
      "JIRA_URL": "${JIRA_URL}",
      "JIRA_USERNAME": "${JIRA_USERNAME}",
      "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
      "ENABLED_TOOLS": "jira_search,jira_get_issue,jira_create_issue,jira_update_issue,jira_add_comment,jira_transition_issue"
    }
  },
  "gmail": {
    "command": "uvx",
    "args": ["--with", "mcp<2", "--from", "mcp-google-gmail", "mcp-google-gmail"],
    "env": {
      "GMAIL_CREDENTIALS_PATH": "${GMAIL_CREDENTIALS_PATH}"
    }
  }
}